{
  "name": "harvest",
  "version": "0.1.0",
  "description": "Self-hosted seedbox to homelab sync: pulls files from FTP/FTPS/SFTP servers on a schedule, with a ledger so deleted files are never re-downloaded.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check:limits": "node scripts/check-limits.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "@fastify/view": "^12.0.0",
    "better-sqlite3": "^12.11.1",
    "croner": "^10.0.1",
    "cronstrue": "^3.29.0",
    "eta": "^3.5.0",
    "fastify": "^5.12.5",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
