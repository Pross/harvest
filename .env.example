# Harvest environment (placeholders only; never commit real values).
PORT=8099                      # HTTP port
HOST=0.0.0.0                   # bind address
APP_SECRET=change-me-generate-a-long-random-string   # encrypts stored credentials; keep stable
CONFIG_DIR=/config             # SQLite db, tmp, logs
ALLOWED_HOSTS=                 # optional Host header allowlist, comma-separated
BROWSE_ROOTS=/data             # container paths the local folder browser may expose, comma-separated
AUTH_MODE=builtin              # builtin | none
ADMIN_USER=                    # optional first-run admin bootstrap
ADMIN_PASS=                    # optional, at least 8 characters
COOKIE_SECURE=false            # true when served over https
TRUST_PROXY=false              # true behind a reverse proxy
PUBLIC_URL=                    # e.g. https://harvest.example.com, used for webhook URLs
MAX_CONCURRENT_RUNS=2          # global run cap
MAX_CONCURRENT_FILES=4         # global file cap across runs
RCLONE_BIN=rclone              # rclone binary (image sets /usr/local/bin/rclone)
RANGE_MIN_BYTES=268435456      # files below this use a single range
CHECKPOINT_BYTES=16777216      # fsync + DB checkpoint interval per range
STALL_TIMEOUT_SECONDS=120      # no bytes on a range: kill and retry
CONNECT_TIMEOUT_SECONDS=30     # rclone connect / first byte
LOG_LEVEL=info                 # silent|fatal|error|warn|info|debug|trace
TZ=UTC                         # schedules and bandwidth profiles
PUID=99                        # container user id (entrypoint)
PGID=100                       # container group id (entrypoint)
UMASK=002                      # file creation mask (entrypoint)
